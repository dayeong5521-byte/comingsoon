{
  "version": 2,
  "builds": [
    {
      "src": "public/**/*",
      "use": "@vercel/static"
    },
    {
      "src": "api/hunt.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/api/hunt",
      "dest": "/api/hunt.js"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/public/index.html"
    }
  ]
}
